<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ================================================================== -->
    <!-- platform-glue.permissions#1: the five upstream declares, in its     -->
    <!-- order. Three of them (POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED,   -->
    <!-- VIBRATE) would also arrive through the flutter_local_notifications  -->
    <!-- manifest merge, but the two exact-alarm ones would not, and         -->
    <!-- FlutterAlarmScheduler asks AlarmManager.canScheduleExactAlarms()    -->
    <!-- before it sets anything: without them the answer is false on API    -->
    <!-- 31+ and no reminder is ever scheduled                               -->
    <!-- (reminders.exact-alarm-scheduling#3). Declaring all five here keeps  -->
    <!-- the app's own manifest a complete statement of what it needs        -->
    <!-- instead of a function of which plugins happen to be linked.         -->
    <!--                                                                    -->
    <!-- platform-glue.permissions#2: no storage permission — file output    -->
    <!-- goes through path_provider, file_picker and share_plus.             -->
    <!-- ================================================================== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ================================================================== -->
    <!-- app-identity.launcher-icon#1: the launcher entry is labelled         -->
    <!-- @string/main_activity_title ("Habits"), NOT the store/about name     -->
    <!-- @string/app_name ("Loop Habit Tracker"), and its icon is             -->
    <!-- @mipmap/ic_launcher — which resolves to the adaptive icon on API     -->
    <!-- 26+. Both strings are localized resources, so the label follows the  -->
    <!-- Android 13 per-app language setting. The activity repeats the label, -->
    <!-- as upstream's ListHabitsActivity and .MainActivity alias do.         -->
    <!--                                                                      -->
    <!-- app-identity.launcher-icon#5: no android:roundIcon and no            -->
    <!-- <shortcuts> meta-data, so launchers get no round variant and the app -->
    <!-- exposes no static or dynamic app shortcuts.                          -->
    <!-- ================================================================== -->
    <!-- ================================================================== -->
    <!-- platform-glue.manifest-components#1: upstream's <application>        -->
    <!-- carries eight attributes. Seven of them survive here:               -->
    <!--                                                                     -->
    <!--   android:name        — ".HabitsApplication" becomes                -->
    <!--                         ${applicationName}, the Flutter embedding's -->
    <!--                         Application class. The startup sequence      -->
    <!--                         HabitsApplication.onCreate performed is now  -->
    <!--                         AppScope.boot() (platform-glue.app-startup-  -->
    <!--                         order), which runs in Dart and therefore     -->
    <!--                         cannot be an Application subclass.           -->
    <!--   android:label       — @string/main_activity_title ("Habits"),      -->
    <!--                         not @string/app_name.                        -->
    <!--   android:icon        — @mipmap/ic_launcher.                         -->
    <!--   android:allowBackup — true, as upstream.                          -->
    <!--   android:supportsRtl — true. It still matters even though the       -->
    <!--                         Flutter UI mirrors through Directionality:    -->
    <!--                         the widget RemoteViews layouts and the three  -->
    <!--                         picker dialogs below are real Android views.  -->
    <!--   android:theme       — lives on the activity here, because that is   -->
    <!--                         where the Flutter embedding looks for         -->
    <!--                         LaunchTheme/NormalTheme (settings.theme.      -->
    <!--                         system-night-window-background).              -->
    <!--                                                                     -->
    <!--   android:localeConfig — @xml/locales_config, as upstream. It was      -->
    <!--                         once left out here on the reading that         -->
    <!--                         MaterialApp.supportedLocales replaced it;      -->
    <!--                         that reading was wrong                         -->
    <!--                         (audit4.android-localeconfig-is-dropped-so-    -->
    <!--                         the#1). supportedLocales decides which         -->
    <!--                         translation the app picks once Android has     -->
    <!--                         told it what the locale is; only this          -->
    <!--                         attribute makes Android offer the choice, by   -->
    <!--                         listing the app under Settings > System >      -->
    <!--                         Languages > App languages. And                 -->
    <!--                         platform-glue.locale-config#10 records that    -->
    <!--                         there is deliberately no in-app language row,  -->
    <!--                         so that system picker is the ONLY way to run   -->
    <!--                         Loop in a language other than the phone's.     -->
    <!--                         The list itself is res/xml/locales_config.xml. -->
    <!--                                                                     -->
    <!-- One is deliberately absent:                                          -->
    <!--                                                                     -->
    <!--   android:backupAgent — there is no BackupAgentHelper; see the       -->
    <!--                         ledger note on platform-glue.backup-agent.   -->
    <!--                         allowBackup on its own gives Auto Backup.    -->
    <!--                                                                     -->
    <!-- platform-glue.manifest-components#11: and no                         -->
    <!-- com.google.android.backup.api_key meta-data, because the Android     -->
    <!-- Backup Service key belongs to a registered key/value backup agent    -->
    <!-- this port does not have.                                            -->
    <!-- ================================================================== -->
    <application
        android:label="@string/main_activity_title"
        android:name="${applicationName}"
        android:allowBackup="true"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/main_activity_title"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ============================================================== -->
        <!-- Rescheduling reminders after a reboot                          -->
        <!--                                                                -->
        <!-- Port of the ReminderReceiver declaration in                    -->
        <!-- uhabits-android/src/main/AndroidManifest.xml, whose only       -->
        <!-- intent-filter is BOOT_COMPLETED                                -->
        <!-- (reminders.boot-reschedule#1, intents.actions-and-extras#15).  -->
        <!--                                                                -->
        <!-- Upstream the receiver calls                                    -->
        <!-- ReminderController.onBootCompleted(), which is exactly         -->
        <!-- reminderScheduler.scheduleAll() (reminders.boot-reschedule#2,  -->
        <!-- #3). This port has no fire-time hook: an alarm IS the finished -->
        <!-- notification, handed to the OS by zonedSchedule. Android drops -->
        <!-- every such alarm on reboot, and                                -->
        <!-- ScheduledNotificationBootReceiver is what puts them all back — -->
        <!-- the same "re-arm everything that was armed" pass, run by the   -->
        <!-- plugin instead of by the core scheduler.                       -->
        <!--                                                                -->
        <!-- flutter_local_notifications does NOT declare this receiver in  -->
        <!-- its own manifest; without the block below, reminders simply    -->
        <!-- stop after the first reboot.                                   -->
        <!-- ============================================================== -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ============================================================== -->
        <!-- Delivering a reminder at its scheduled time                    -->
        <!--                                                                -->
        <!-- audit5.android-reminders-never-fire-flutter-local#1: upstream  -->
        <!-- AlarmManager fires an explicit broadcast PendingIntent at      -->
        <!-- .receivers.ReminderReceiver, declared in                       -->
        <!-- uhabits-android/src/main/AndroidManifest.xml, and              -->
        <!-- ReminderController.onShowReminder posts the notification.      -->
        <!--                                                                -->
        <!-- Here the alarm IS the finished notification: zonedSchedule     -->
        <!-- hands it to AlarmManager and the plugin's                      -->
        <!-- ScheduledNotificationReceiver is the component the broadcast   -->
        <!-- is addressed to at the scheduled instant. It is what turns an  -->
        <!-- armed alarm into a posted notification, and since version 16   -->
        <!-- flutter_local_notifications declares NO receivers in its own   -->
        <!-- manifest (it now ships only the VIBRATE and POST_NOTIFICATIONS -->
        <!-- permissions) — so while this was missing, every reminder was   -->
        <!-- scheduled successfully and then delivered to a component that  -->
        <!-- did not exist. No habit reminder ever appeared.                -->
        <!--                                                                -->
        <!-- No intent-filter: AlarmManager addresses it by component name. -->
        <!-- Not exported: the PendingIntent is one this app built for      -->
        <!-- itself, so nothing outside the app needs to reach it.          -->
        <!-- ============================================================== -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- ============================================================== -->
        <!-- The 'Yes' and 'No' buttons on a reminder                       -->
        <!--                                                                -->
        <!-- audit5.reminder-yes-no-buttons-are-dead#1: upstream both are   -->
        <!-- broadcast PendingIntents to the manifest-declared              -->
        <!-- WidgetReceiver, and WidgetBehavior.onAddRepetition /           -->
        <!-- onRemoveRepetition writes the entry and cancels the            -->
        <!-- notification whether or not the app process is alive.          -->
        <!--                                                                -->
        <!-- flutter_notification_tray builds those two as                  -->
        <!-- AndroidNotificationAction(showsUserInterface: false), which is -->
        <!-- exactly the branch where the plugin posts a                    -->
        <!-- PendingIntent.getBroadcast addressed to its own                -->
        <!-- ActionBroadcastReceiver; that receiver cancels the             -->
        <!-- notification if asked, then spins up a background isolate and  -->
        <!-- calls the entry point registered as                            -->
        <!-- onDidReceiveBackgroundNotificationResponse. Without this       -->
        <!-- declaration the broadcast has no target: tapping Yes or No did -->
        <!-- nothing at all, not even with the app in the foreground,       -->
        <!-- because the tap never left the system.                         -->
        <!--                                                                -->
        <!-- Not exported, per the plugin README. That is also what keeps   -->
        <!-- the port from reopening the hole upstream left with            -->
        <!-- android:permission="false" on WidgetReceiver                   -->
        <!-- (intents.widget-receiver-dispatch#12): only this app's own     -->
        <!-- notification can drive it.                                     -->
        <!-- ============================================================== -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- ============================================================== -->
        <!-- Home-screen widgets                                            -->
        <!--                                                                -->
        <!-- Port of the widget block in                                    -->
        <!-- uhabits-android/src/main/AndroidManifest.xml.                  -->
        <!--                                                                -->
        <!-- widgets.registration#1: exactly six providers, with the        -->
        <!-- launcher labels 'Checkmark', 'History', 'Score', 'Streaks',    -->
        <!-- 'Frequency' and 'Target'. The labels are literals rather than  -->
        <!-- @string resources because this project has no strings.xml.     -->
        <!--                                                                -->
        <!-- widgets.registration#8: every receiver is exported and         -->
        <!-- declares only the APPWIDGET_UPDATE filter.                     -->
        <!--                                                                -->
        <!-- widgets.registration#7: StackWidgetService, non-exported and    -->
        <!-- guarded by BIND_REMOTEVIEWS so only the system may bind it.    -->
        <!-- Upstream removed the option to *create* stack widgets, but a   -->
        <!-- placement whose stored preference holds anything other than    -->
        <!-- exactly one habit id is still one, and those survive an app    -->
        <!-- update — including this port. See StackWidget.kt.              -->
        <!-- ============================================================== -->

        <service
            android:name=".widgets.StackWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- widgets.registration#6: the three configure activities. -->
        <activity
            android:name=".widgets.activities.HabitPickerDialog"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.Alert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widgets.activities.BooleanHabitPickerDialog"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.Alert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widgets.activities.NumericalHabitPickerDialog"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.Alert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widgets.CheckmarkWidgetProvider"
            android:exported="true"
            android:label="@string/checkmark">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_checkmark_info" />
        </receiver>

        <receiver
            android:name=".widgets.HistoryWidgetProvider"
            android:exported="true"
            android:label="@string/history">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_history_info" />
        </receiver>

        <receiver
            android:name=".widgets.ScoreWidgetProvider"
            android:exported="true"
            android:label="@string/score">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_score_info" />
        </receiver>

        <receiver
            android:name=".widgets.StreakWidgetProvider"
            android:exported="true"
            android:label="@string/streaks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

        <receiver
            android:name=".widgets.FrequencyWidgetProvider"
            android:exported="true"
            android:label="@string/frequency">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_frequency_info" />
        </receiver>

        <receiver
            android:name=".widgets.TargetWidgetProvider"
            android:exported="true"
            android:label="@string/target">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_target_info" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
