<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-API-21 launch window. `?android:colorBackground` is only usable as
     a drawable reference from API 21 on, so this variant names the colour
     directly; the -night qualifier still swaps it, because the resource it
     names is the qualified one. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/color_background" />
</layer-list>
