<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Port of uhabits-android/src/main/res/layout/frequency_stackview_widget.xml.
  ~
  ~ widgets.stack#4: a FrameLayout holding a looping StackView over a full-bleed
  ~ empty-state TextView (white, bold, 16sp, centred).
  ~ widgets.stack#5: the label is upstream's @string/frequency_stack_widget, inlined
  ~ because this project has no strings.xml.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <StackView
        android:id="@+id/frequencyStackWidgetView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />

    <TextView
        android:id="@+id/frequencyStackWidgetEmptyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Frequency Stack Widget"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold" />

</FrameLayout>
