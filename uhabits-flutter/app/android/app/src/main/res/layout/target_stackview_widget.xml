<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Port of uhabits-android/src/main/res/layout/target_stackview_widget.xml.
  ~
  ~ widgets.stack#4: a FrameLayout holding a looping StackView over a full-bleed
  ~ empty-state TextView (white, bold, 16sp, centred).
  ~ widgets.stack#5: the label is upstream's @string/streaks_stack_widget, kept as a
  ~ string resource so the launcher resolves it in the device language
  ~ (audit.android-widget-chrome-text-is-hard#1). res/values*/strings.xml
  ~ is generated from app/lib/l10n/app_*.arb; android:text takes a
  ~ resource or a literal and nothing else, which is why this label
  ~ cannot travel in the published widget document.
  ~
  ~ Upstream points this layout at R.string.streaks_stack_widget rather than
  ~ a target-specific string. It is a bug (widgets.stack#5) and it is
  ~ reproduced, not corrected.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <StackView
        android:id="@+id/targetStackWidgetView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />

    <TextView
        android:id="@+id/targetStackWidgetEmptyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/streaks_stack_widget"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold" />

</FrameLayout>
